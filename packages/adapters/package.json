{
  "name": "@job-search-os/adapters",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "llm:smoke": "tsx src/llm/smoke.ts",
    "llm:spend": "tsx src/llm/spend-cli.ts",
    "ingest:getonboard": "tsx src/ingest/cli.ts",
    "worker:evaluate": "tsx src/worker/cli.ts",
    "market:snapshot": "tsx src/market/cli.ts",
    "plan:build": "tsx src/market/plan-cli.ts",
    "skills:extract": "tsx src/skills/cli.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "worker:requeue": "tsx src/worker/requeue-cli.ts",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=text"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.52",
    "@ai-sdk/google": "^4.0.67",
    "@job-search-os/db": "workspace:*",
    "@job-search-os/pipeline": "workspace:*",
    "@job-search-os/prompts": "workspace:*",
    "ai": "^7.0.97",
    "drizzle-orm": "^0.45.2",
    "pino": "^10.3.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "4.1.11",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
