{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["VERCEL_GIT_COMMIT_SHA"],
      "passThroughEnv": [
        "DB_TARGET",
        "LLM_DEMO",
        "DATABASE_URL_APP",
        "CONTACT_EMAIL",
        "SITE_URL",
        "LEGACY_HOSTS"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
