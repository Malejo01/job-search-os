{
  "name": "job-search-os",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "clean": "turbo run clean && rimraf node_modules",
    "db:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:reset": "docker compose -f infra/docker-compose.yml down -v && docker compose -f infra/docker-compose.yml up -d --wait",
    "db:logs": "docker compose -f infra/docker-compose.yml logs -f postgres",
    "db:psql": "docker compose -f infra/docker-compose.yml exec postgres psql -U postgres -d jobsearch",
    "db:generate": "pnpm --filter @job-search-os/db db:generate",
    "db:migrate": "pnpm --filter @job-search-os/db db:migrate",
    "db:seed": "pnpm --filter @job-search-os/db db:seed",
    "evals": "pnpm --filter @job-search-os/evals cli",
    "db:migrate:local": "pnpm --filter @job-search-os/db db:migrate --local",
    "db:seed:local": "pnpm --filter @job-search-os/db db:seed --local",
    "db:sql": "pnpm --filter @job-search-os/db db:sql",
    "test:integration:cloud": "pnpm --filter @job-search-os/db test:integration:cloud",
    "ingest:getonboard": "pnpm --filter @job-search-os/adapters ingest:getonboard",
    "worker:evaluate": "pnpm --filter @job-search-os/adapters worker:evaluate",
    "llm:spend": "pnpm --filter @job-search-os/adapters llm:spend",
    "market:snapshot": "pnpm --filter @job-search-os/adapters market:snapshot",
    "plan:build": "pnpm --filter @job-search-os/adapters plan:build",
    "e2e": "pnpm --filter @job-search-os/web e2e",
    "skills:extract": "pnpm --filter @job-search-os/adapters skills:extract",
    "worker:requeue": "pnpm --filter @job-search-os/adapters worker:requeue"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "15.5.25",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.1",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
