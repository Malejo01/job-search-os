# Copiar a .env.local y completar. Nunca commitear .env.local (CLAUDE.md §6).
# Nube (Neon, ADR-009): pooled para la app, directa (unpooled) para migraciones y seeds.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Rol de la app (jobsearch_app, sin ownership ni BYPASSRLS: RLS aplica). Si falta, cae a DATABASE_URL.
DATABASE_URL_APP=
# Docker local (infra/docker-compose.yml). Opcional: es el default de --local / DB_TARGET=local.
DATABASE_URL_LOCAL=postgres://postgres:postgres@localhost:54322/jobsearch
DATABASE_URL_APP_LOCAL=postgres://jobsearch_app:jobsearch_app@localhost:54322/jobsearch
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Guardarraíles de costo LLM (ver docs/LLM_COSTOS.md). Tope de gasto del worker en 24 h móviles, USD (0 = sin tope).
LLM_DAILY_CAP_USD=2
# Timeout duro por llamada al proveedor, ms.
LLM_CALL_TIMEOUT_MS=90000
CRON_SECRET=
# Auth.js (ADR-010): secreto de firma de la sesión (openssl rand -base64 32).
AUTH_SECRET=
# Usuario único creado por el seed. Sin SEED_USER_PASSWORD el usuario queda sin contraseña (no puede entrar).
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
# Servidor MCP propio (JS-035): token compartido, Bearer o ?token=. openssl rand -hex 32. Sin token el endpoint responde 401.
MCP_TOKEN=
# Usuario que opera el MCP (users.id). Si falta, se usa el único usuario de la tabla users.
MCP_USER_ID=
# Tokens personales del MCP (MCP-1, ADR-032): "testers" los habilita para ADMIN_EMAILS y ASSISTANT_TESTER_EMAILS
# (mismo gate que el asistente). Cualquier otro valor o vacío: apagados. ?token= sigue pidiendo MCP_ALLOW_QUERY_TOKEN=1.
MCP_USER_TOKENS=
# next dev contra Docker: DB_TARGET=local (la app usa DATABASE_URL_APP_LOCAL)
# Email entrante (JS-020, ADR-003) y saliente (JS-045, recuperar contraseña): Resend.
# Secret de firma del webhook (whsec_...) y API key, usada tanto para pedir el cuerpo entrante
# como para mandar el link de recuperación (POST /emails).
RESEND_WEBHOOK_SECRET=
RESEND_API_KEY=
# Remitente del email de recuperación. Sin dominio propio verificado en Resend, dejar vacío:
# usa el sandbox onboarding@resend.dev, que solo entrega al email de tu cuenta de Resend.
EMAIL_FROM=
# Dominio de ingesta: cada usuario recibe u_<id>@<INGEST_DOMAIN> (registros MX en Resend)
INGEST_DOMAIN=ingest.<tu-dominio>
# --- Tanda C8 (todas apagadas por defecto; detalle en docs/beta/tanda-c8.md) ---
# Embudo de /acceso en /settings/metricas (C8-2). "1" lo prende; antes, aplicar la migración 0057.
ACCESO_FUNNEL_ENABLED=
# Topes del evento con QR en /acceso (C8-3): "inicio/fin" ISO con zona, máximo 12 h, solo para
# ?origen=voces-jovenes. Ej.: 2026-11-11T19:00:00-03:00/2026-11-11T22:00:00-03:00. Vacía = topes normales.
WAITLIST_EVENT_WINDOW=
# «Empezá acá» en /hoy (C8-5): checklist para personas nuevas. "1" la prende. Sin migración.
START_HERE_ENABLED=
# «¿Qué es esto?» en puntaje, A tu favor/Te falta, Sin descripción, CV y áreas (C8-6). "1" la prende.
HELP_TIPS_ENABLED=
# Email de bienvenida al activar el plan en /settings/planes (C8-7). "1" lo prende; usa RESEND_API_KEY y EMAIL_FROM.
WELCOME_EMAIL_ENABLED=
# Neon (C8-15), después de aplicar la migración 0058: idioma del aviso persistido en public_jobs y
# candidatos de /market en market_candidates. "1" los prende.
PUBLIC_JOBS_LANGUAGE_ENABLED=
MARKET_CANDIDATES_ENABLED=
# Triage del feedback en /settings/feedback (C8-17): filtros, estado y CSV. "1" lo prende; antes, la migración 0059.
FEEDBACK_TRIAGE_ENABLED=
# Barra de pestañas abajo en el celular (R-3): Hoy, Ofertas, Pendientes y Perfil. "1" la prende. Sin migración.
MOBILE_TABBAR_ENABLED=
